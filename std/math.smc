# ==============================================================================
# SMC Standard Library: Math & Statistics (std/math.smc)
# ==============================================================================

func mean(numbers) {
    if len(numbers) == 0 {
        return 0.0
    }
    var total = 0.0
    for n in numbers {
        total += n
    }
    return total / len(numbers)
}

func min_val(numbers) {
    if len(numbers) == 0 {
        return 0
    }
    var smallest = numbers[0]
    for n in numbers {
        if n < smallest {
            smallest = n
        }
    }
    return smallest
}

func max_val(numbers) {
    if len(numbers) == 0 {
        return 0
    }
    var largest = numbers[0]
    for n in numbers {
        if n > largest {
            largest = n
        }
    }
    return largest
}

func moving_average(numbers, win_size) {
    var windows = window(numbers, win_size, 1)
    var smoothed = []
    for win in windows {
        var avg = mean(win)
        push(smoothed, round(avg, 2))
    }
    return smoothed
}
